{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "PKI Maturity Model schema",
  "description": "Schema for the machine-readable PKI Maturity Model definition (data/pkimm-model-<version>.yaml).",
  "version": "2.0.0",
  "type": "object",
  "required": ["schemaVersion", "version", "modules"],
  "properties": {
    "schemaVersion": { "type": "string", "const": "2.0.0" },
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "modules": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "description", "categories"],
        "properties": {
          "id": { "type": "string", "pattern": "^[GMOR]$" },
          "name": {
            "type": "string",
            "pattern": "^(Governance|Management|Operations|Resources)$"
          },
          "description": { "type": "string" },
          "categories": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["id", "weight", "name", "description", "levels"],
              "properties": {
                "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
                "weight": { "type": "integer" },
                "name": { "type": "string" },
                "description": { "type": "string" },
                "levels": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": ["number", "name", "description"],
                    "properties": {
                      "number": { "type": "integer" },
                      "name": {
                        "type": "string",
                        "pattern": "^(Initial|Foundational|Advanced|Managed|Optimized)$"
                      },
                      "description": { "type": "string" }
                    }
                  }
                },
                "requirements": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": ["id", "weight", "description", "guidance", "assessment", "references"],
                    "properties": {
                      "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
                      "weight": { "type": "integer" },
                      "description": { "type": "string" },
                      "guidance": { "type": "string" },
                      "assessment": { "type": "string" },
                      "references": {
                        "type": "array",
                        "items": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
